# Speech service settings (copy to speech/.env, or set them in the
# environment or speech/compose.yaml's .env). See "Choosing the AI
# engines" in the README.

# Shared with the conference server (its SPEECH_SECRET).
SPEECH_SECRET=

# Transcription: local (faster-whisper on this machine, the default) or
# openai-compatible. Live subtitles always come from the local Whisper.
TRANSCRIBE_PROVIDER=local
WHISPER_MODEL=
DEVICE=cpu
# TRANSCRIBE_URL=https://api.openai.com/v1
# TRANSCRIBE_API_KEY=
# TRANSCRIBE_MODEL=

# Translation: ollama (the default) or openai-compatible. There is no
# default model; until one is set, live translation shows as unavailable.
TRANSLATE_PROVIDER=ollama
TRANSLATE_URL=http://localhost:11434
TRANSLATE_MODEL=
# TRANSLATE_API_KEY=

# A local OpenAI-compatible server (vLLM, LM Studio, ...) instead:
# TRANSLATE_PROVIDER=openai-compatible
# TRANSLATE_URL=http://localhost:1234/v1
# TRANSLATE_MODEL=

# Voice: piper (on this machine, the default; run `just speech-setup` for
# the voices) or openai-compatible, whose voice names go in
# languages.yaml (api_voices) or VOICE_NAME.
VOICE_PROVIDER=piper
# VOICE_URL=https://api.openai.com/v1
# VOICE_API_KEY=
# VOICE_MODEL=
# VOICE_NAME=
# VOICE_RATE=24000

# One key for every openai-compatible engine, instead of the ones above.
# OPENAI_API_KEY=

# Override the guess whether an engine is outside your network (it decides
# the "external service" notice), e.g. for an internal domain name:
# TRANSLATE_EXTERNAL=false
