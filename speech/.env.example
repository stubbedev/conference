# Speech service settings. Copy to speech/.env for speech/compose.yaml,
# or set them in the environment. See speech/README.md.

# Shared with the conference server (its SPEECH_SECRET).
SPEECH_SECRET=

# One address and key for every OpenAI-compatible engine below, unless an
# engine sets its own <ENGINE>_URL / <ENGINE>_API_KEY.
# OPENAI_URL=https://api.openai.com/v1
# OPENAI_API_KEY=

# Transcription: any OpenAI-compatible /audio/transcriptions endpoint,
# e.g. whisper.cpp's whisper-server on this network.
# TRANSCRIBE_URL=http://whisper:8080/v1
TRANSCRIBE_MODEL=

# Translation: ollama (the default) or openai-compatible.
TRANSLATE_PROVIDER=ollama
TRANSLATE_URL=http://localhost:11434
TRANSLATE_MODEL=

# Voice: any OpenAI-compatible /audio/speech endpoint that returns raw
# 16-bit PCM. Voice names per language go in a languages file
# (LANGUAGES_FILE), or one name for all in VOICE_NAME.
# VOICE_URL=
VOICE_MODEL=
VOICE_NAME=
# VOICE_RATE=24000

# Override the guess whether an engine is outside your network:
# TRANSLATE_EXTERNAL=false
