# Host users will visit, e.g. meet.example.com (no scheme).
BASE_URL=meet.example.com
# Email for Let's Encrypt expiry notices.
ACME_EMAIL=you@example.com
# Comma-separated keys required to create rooms. Leave empty to allow
# anyone on the internet to create rooms.
API_KEYS=
# true hides room creation on the landing page: visitors can only join
# rooms, which then come from the HTTP API (requires API_KEYS above).
JOIN_ONLY=false
# Delete rooms (and their sessions) older than this many days, checked
# hourly. 0 keeps rooms forever. Rooms with live calls are never reaped.
ROOM_TTL_DAYS=365
# Comma-separated public IPv4/IPv6 addresses of the host. Required when
# running behind NAT so ICE can advertise the right candidates.
EXTERNAL_IPS=
