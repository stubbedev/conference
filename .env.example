# Host users will visit, e.g. meet.example.com (no scheme). The app is
# served at https://$DOMAIN, which is also the origin in its links.
DOMAIN=meet.example.com
# Second hostname pointing at this server, for TURN over TLS on port 443
# (the only way through networks that allow nothing but HTTPS out).
TURN_TLS_HOST=turn.meet.example.com
# Email for Let's Encrypt expiry notices.
ACME_EMAIL=you@example.com
# Comma-separated keys required to create rooms. Leave empty to allow
# anyone on the internet to create rooms.
API_KEYS=
# true hides room creation on the landing page: visitors can only join
# rooms, which then come from the HTTP API (requires API_KEYS above).
JOIN_ONLY=false
# Comma-separated hostnames where room creation stays open (no API key,
# create form shown) despite API_KEYS/JOIN_ONLY — e.g. when one server
# serves several domains with different policies.
OPEN_CREATE_HOSTS=
# Comma-separated further origins (https://other.example.com) this
# server also answers on; their links and link previews stay on them.
PUBLIC_ORIGINS=
# Delete rooms (and their sessions) older than this many days, checked
# hourly. 0 keeps rooms forever. Rooms with live calls are never reaped.
ROOM_TTL_DAYS=365
# Comma-separated public IPv4/IPv6 addresses of the host. Required when
# running behind NAT so ICE can advertise the right candidates.
EXTERNAL_IPS=
# Signing Secret of your Slack app; enables the /meet slash command
# (see "Start meetings from Slack" in the README). Leave empty to disable.
SLACK_SIGNING_SECRET=
# Live translation (see "Live translation" in the README): the speech
# service's WebSocket address and the secret it shares with this server.
# Set both or neither. Without them, live translation shows greyed out
# with what has to be set up.
SPEECH_URL=
SPEECH_SECRET=
# Optional: where this server checks the speech service is ready, e.g. an
# internal http://speech:8090/v1/status. Defaults to SPEECH_URL's /v1/status.
SPEECH_STATUS_URL=
