# Host users will visit, e.g. meet.example.com (no scheme). The app is
# served at https://$DOMAIN, which is also the origin in its links.
DOMAIN=meet.example.com
# Second hostname pointing at this server, for TURN over TLS on port 443
# (the only way through networks that allow nothing but HTTPS out).
TURN_TLS_HOST=turn.meet.example.com
# Email for Let's Encrypt expiry notices.
ACME_EMAIL=you@example.com
# Comma-separated keys required to create rooms. Leave empty to allow
# anyone on the internet to create rooms.
API_KEYS=
# true hides room creation on the landing page: visitors can only join
# rooms, which then come from the HTTP API (requires API_KEYS above).
JOIN_ONLY=false
# Comma-separated hostnames where room creation stays open (no API key,
# create form shown) despite API_KEYS/JOIN_ONLY — e.g. when one server
# serves several domains with different policies.
OPEN_CREATE_HOSTS=
# Comma-separated further origins (https://other.example.com) this
# server also answers on; their links and link previews stay on them.
PUBLIC_ORIGINS=
# Delete rooms (and their sessions) older than this many days, checked
# hourly. 0 keeps rooms forever. Rooms with live calls are never reaped.
ROOM_TTL_DAYS=365
# Comma-separated public IPv4/IPv6 addresses of the host. Required when
# running behind NAT so ICE can advertise the right candidates.
EXTERNAL_IPS=
# Signing Secret of your Slack app; enables the /meet slash command
# (see "Start meetings from Slack" in the README). Leave empty to disable.
SLACK_SIGNING_SECRET=
# Live translation (see docs/live-translation.md). By default the
# server runs the speech service itself; these choose its engines. Until
# all three have a model, live translation shows greyed out with what has
# to be set up.
#
# server (the default) runs the engines on this server, browser runs
# them in every member's browser. In browser mode TRANSCRIBE_*,
# TRANSLATE_* and VOICE_* are not used, and no audio or text leaves the
# member's machine: the browsers load their models from this server,
# which fetches each file from the Hugging Face Hub the first time a
# browser asks for it and caches it in SPEECH_MODEL_DIR, which must be
# writable. SPEECH_MODEL_CACHE_MAX bounds that cache (15GB by default);
# the files used longest ago go first.
# SPEECH_RUNTIME=server
# SPEECH_MODEL_DIR=/models
# SPEECH_MODELS_FILE=/models/models.json
# SPEECH_MODEL_CACHE_MAX=15GB
#
# models.json names the exports and the voice for each language, and
# lists every file under "files"; web/scripts/fetch-speech-models.mjs
# writes it:
# {
#   "asr": { "model": "onnx-community/whisper-large-v3-turbo", "dtype": "q4f16",
#            "fallback": { "model": "onnx-community/whisper-base", "dtype": "q4" } },
#   "mt": { "kind": "seq2seq", "model": "Xenova/m2m100_418M", "dtype": "q4f16" },
#   "tts": { "en": "en_US-joe-medium", "de": "de_DE-thorsten-medium" },
#   "files": { "piper/en_US-joe-medium.onnx": { "repo": "rhasspy/piper-voices",
#              "revision": "<commit>", "file": "en/en_US/joe/medium/en_US-joe-medium.onnx",
#              "size": 63201294, "md5": "<digest>" }, ... }
# }
#
# The cache holds each model as <owner>/<model>/config.json,
# with onnx/<name>_<dtype>.onnx beside it, and each voice as
# piper/<voice>.onnx with piper/<voice>.onnx.json next to it.
#
# The key for every OpenAI-compatible engine below that doesn't set its
# own <ENGINE>_API_KEY. Each engine's URL defaults to OpenAI's.
# OPENAI_API_KEY=
#
# Transcription: any OpenAI-compatible /audio/transcriptions endpoint,
# e.g. whisper.cpp's whisper-server on this machine.
# TRANSCRIBE_URL=http://host.docker.internal:8081/v1
TRANSCRIBE_MODEL=
# verbose_json drops what Whisper marks as non-speech (whisper.cpp, whisper-1;
# not the gpt-4o models, which accept only json).
# TRANSCRIBE_RESPONSE_FORMAT=json
# Interim subtitles: on (600) for transcription on your network, off (0)
# for an external one, where each call is billed.
# INTERIM_MS=
#
# Translation: ollama (the default) or openai-compatible. An Ollama on the
# Docker host is http://host.docker.internal:11434.
TRANSLATE_PROVIDER=ollama
TRANSLATE_URL=http://host.docker.internal:11434
TRANSLATE_MODEL=
#
# Voice: any OpenAI-compatible /audio/speech endpoint that returns WAV.
# Voice names per language go in a languages file (LANGUAGES_FILE), or
# one name for all in VOICE_NAME.
# VOICE_URL=
VOICE_MODEL=
VOICE_NAME=
# true if the voice engine clones a voice from a recording (voice_ref, as
# audio.cpp takes it): speakers are then offered to be heard in their own
# voice (see docs/live-translation.md). Otherwise the option isn't shown.
VOICE_CLONING=
# Or: a voice conversion engine (audio.cpp's /tasks/run with a "vc" model)
# that turns the stock voice into the speaker's own; both or neither.
# VOICE_CONVERT_URL=
# VOICE_CONVERT_MODEL=
# VOICE_CONVERT_API_KEY=
#
# Domains on your network, so engines under them don't count as external:
# INTERNAL_DOMAINS=corp.example.com
# Term translations the translator must use; in browser mode only a
# translating language model (mt kind llm) follows them:
# GLOSSARY=Kontainer = Kontainer
