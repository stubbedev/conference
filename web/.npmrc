# Dependencies are installed without running their install scripts. None
# of them needs its own: onnxruntime-node's downloads CUDA libraries from
# a host outside the npm registry for a Node binding nothing here loads
# (the speech engines run in the browser on onnxruntime-web), and
# protobufjs's only prints a warning.
#
# With this set npm also skips the pre- and post-scripts of package.json,
# so it has none: scripts/package.test.mjs fails when one appears.
ignore-scripts=true
